{
  "name": "campus-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write .",
    "knip": "knip",
    "verify": "bun run typecheck && bun run check && bun run knip",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hono/zod-validator": "^0.9.1",
    "@opennextjs/cloudflare": "^1.20.16",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.119.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "aws4fetch": "^1.0.20",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.7.1",
    "gsap": "^3.15.1",
    "hono": "^4.13.16",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "next": "^16.4.5",
    "next-safe-action": "^7.10.8",
    "nuqs": "^2.10.2",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.30.6",
    "knip": "^5.88.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "wrangler": "^3.114.17"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
