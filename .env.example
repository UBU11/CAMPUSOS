# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database Connection (Supavisor Transaction Pooler, Port 6543)
DATABASE_URL="postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Cloudflare R2 Storage (aws4fetch signed presigned URLs)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="campus-os-assets"
NEXT_PUBLIC_R2_PUBLIC_URL="https://assets.yourcampus.edu"

# College Domain & Auth
NEXT_PUBLIC_COLLEGE_DOMAIN="gecskp.ac.in"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
